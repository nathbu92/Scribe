PORT=8787
# Dossier racine : les données seront dans DATA_DIR/Scribe/<feuille>/<personne>/
DATA_DIR=./data
# Clé demandée par Presence pour créer un espace de travail (à choisir, à saisir dans Presence)
WORKSPACE_CREATE_KEY=change-moi
# Facultatif (généré et conservé dans DATA_DIR sinon)
JWT_SECRET=
# Origines autorisées (CORS), séparées par des virgules. * = toutes
CORS_ORIGINS=*
# Notifications mail (Brevo) : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Martinews Scribe
