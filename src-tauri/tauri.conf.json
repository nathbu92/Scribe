{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Martinews Scribe",
  "mainBinaryName": "martinews-scribe",
  "version": "../package.json",
  "identifier": "fr.martinews.scribe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Martinews Scribe", "width": 1280, "height": 800, "minWidth": 720, "minHeight": 520, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; frame-src 'self' blob: https: http: about:; connect-src 'self' ipc: http://ipc.localhost https: http:; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "COLLE_ICI_LA_CLE_PUBLIQUE (npm run tauri signer generate -- -w ~/.tauri/scribe.key)",
      "endpoints": ["https://github.com/bunath/Scribe/releases/latest/download/latest.json"]
    }
  }
}
